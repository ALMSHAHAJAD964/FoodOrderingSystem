<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FoodOrderingSystem
    </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.min.css" />

    <style>

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
        }

        .hero-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 100px 0;
        }

        .food-card {
            transition: transform 0.3s;
        }

            .food-card:hover {
                transform: translateY(-5px);
            }

        .cart-badge {
            position: relative;
            top: -10px;
            left: -5px;
        }

        /* Profile Dropdown */

        .dropdown-menu {
            min-width: 200px;
        }

        .dropdown-item i {
            margin-right: 8px;
        }

    </style>

</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">

        <div class="container">

            <!-- Brand -->

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-shop"></i>
                Food Order

            </a>


            <!-- Mobile Toggle -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- Navbar Content -->

            <div class="collapse navbar-collapse"
                 id="navbarNav">


                <!-- Get Session Values -->
                @{
                    var userId = Context.Session.GetInt32("UserId");

                    var username = Context.Session.GetString("Username");

                    var isAdmin = Context.Session.GetString("IsAdmin");
                }


                <!-- ================= LEFT MENU ================= -->

                <ul class="navbar-nav me-auto">

                    <!-- Home -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house"></i>
                            Home

                        </a>

                    </li>


                    <!-- Menu -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="/Menu">

                            <i class="bi bi-list"></i>
                            Menu

                        </a>

                    </li>
                    @if(Context.Session.GetString("IsAdmin") == "True")
                    {
                        <li class="nav-item"><a class="nav-link" href="/Admin/Dashboard">Admin</a></li>
                    }
                </ul>


                <!-- ================= RIGHT MENU ================= -->

                <ul class="navbar-nav">


                    <!-- Cart -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Order"
                           asp-action="Cart">

                            <i class="bi bi-cart3"></i>

                            Cart

                            <span class="badge bg-danger cart-badge">
                                0
                            </span>

                        </a>

                    </li>


                    @if (userId != null)
                    {

                        <!-- ================= PROFILE DROPDOWN ================= -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="userDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <i class="bi bi-person-circle"></i>

                                Hello, @username

                            </a>


                            <!-- Dropdown Menu -->

                            <ul class="dropdown-menu dropdown-menu-end"
                                aria-labelledby="userDropdown">


                                <!-- My Profile -->

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Account"
                                       asp-action="Profile">

                                        <i class="bi bi-person"></i>

                                        My Profile

                                    </a>

                                </li>


                                <!-- My Orders -->
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Order"
                                       asp-action="MyOrders">
                                        <i class="bi bi-bag"></i>
                                        My Orders
                                    </a>
                                </li>


                                <li>
                                    <hr class="dropdown-divider">
                                </li>


                                <!-- Logout -->

                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-controller="Account"
                                       asp-action="Logout">

                                        <i class="bi bi-box-arrow-right"></i>
                                        Logout

                                    </a>
                                </li>

                            </ul>

                        </li>


                        <!-- ================= ADMIN ================= -->
                        @if (isAdmin == "True")
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2"></i>

                                    Admin

                                </a>

                            </li>

                        }

                    }
                    else
                    {

                        <!-- ================= LOGIN ================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">

                                <i class="bi bi-box-arrow-in-right"></i>

                                Login

                            </a>

                        </li>


                        <!-- ================= REGISTER ================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Register">

                                <i class="bi bi-person-plus"></i>

                                Register

                            </a>

                        </li>

                    }

                </ul>

            </div>

        </div>

    </nav>


    <!-- ================= MAIN CONTENT ================= -->

    <main role="main"
          class="pb-3">

        @RenderBody()

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="bg-dark text-white text-center py-4 mt-5">

        <div class="container">

            <p class="mb-0">

                &copy; 2026 Food Ordering System.
                All rights reserved.

            </p>

        </div>

    </footer>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>


    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>