@model List<FoodItem>
@{
    ViewData["Title"] = "Home Page";
}
<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-3 mb-4">Welcome to Our Food Delivery Service</h1>
        <p class="lead mb-4">Delicious meals delivered to your doorstep.</p>
        <a href="/Menu" class="btn btn-light btn-lg">Order Now <i class="bi bi-arrow-right"></i></a>
    </div>
</div>

<!--Hero Section-->
<div class="hero-section text-center">
    <div class="container my-5">
        <h2 class="text-center mb-4">Featured Items</h2>
        <div class="row">
            @foreach(var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card food-card h-100 shadow">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height:200px; object-fit:cover";>
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                          
                            <p class="card-text"><strong>Price: </strong>@item.Price.ToString("C")</p>
                            <a href="/Order/AddToCart?foodItemId =@item.Id" class="btn btn-primary">
                                <i class="bi bi-cart-plus">Add To Cart</i>
                                </a>
                                  </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>