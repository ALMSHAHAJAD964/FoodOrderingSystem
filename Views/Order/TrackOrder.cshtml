@model Order

@{
    ViewData["Title"] = "Track Order";

    var statusSteps = new List<string>
    {
        "Pending",
        "Confirmed",
        "Preparing",
        "OutForDelivery",
        "Delivered"
    };

    var currentStatusIndex = statusSteps.IndexOf(Model.Status);
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow">

                <!-- Header -->
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

                    <h4 class="mb-0">
                        Order #@Model.Id
                    </h4>

                    <span class="badge bg-light text-dark">
                        @Model.Status
                    </span>

                </div>

                <div class="card-body">

                    <!-- ========================= -->
                    <!-- Order Progress Tracker -->
                    <!-- ========================= -->

                    <div class="progress-tracker mb-5">

                        @if (Model.Status == "Cancelled")
                        {
                            <!-- Cancelled -->
                            <div class="alert alert-danger text-center">

                                <i class="bi bi-x-octagon-fill display-4"></i>

                                <h4 class="mt-3">
                                    Order Cancelled
                                </h4>

                                <p class="mb-0">
                                    This order has been cancelled.
                                </p>

                            </div>
                        }
                        else
                        {
                            <!-- Progress Bar -->

                            <div class="d-flex justify-content-between position-relative mb-3">

                                <!-- Background Progress Line -->
                                <div class="progress position-absolute w-100"
                                     style="height: 5px; top: 20px; z-index: 0;">

                                    <!-- Active Progress -->
                                    <div class="progress-bar bg-success"
                                         role="progressbar"
                                         style="width: @(currentStatusIndex < 0 ? 0 : currentStatusIndex * 25)%;">
                                    </div>

                                </div>


                                <!-- Status Steps -->
                                @for (int i = 0; i < statusSteps.Count; i++)
                                {
                                    var isActive = i <= currentStatusIndex;
                                    var isCurrent = i == currentStatusIndex;

                                    var icon = statusSteps[i] switch
                                    {
                                        "Pending" => "clock",
                                        "Confirmed" => "check-circle",
                                        "Preparing" => "fire",
                                        "OutForDelivery" => "truck",
                                        "Delivered" => "box-seam",
                                        _ => "circle"
                                    };

                                    var displayStatus = statusSteps[i] == "OutForDelivery"
                                    ? "Out for Delivery"
                                    : statusSteps[i];

                                    <div class="text-center position-relative"
                                         style="z-index: 1; width: 20%;">

                                        <!-- Icon Circle -->
                                        <div class="rounded-circle
                                                            d-flex
                                                            justify-content-center
                                                            align-items-center
                                                            mx-auto
                                                            mb-2
                                                            @(isActive
                                                                                                     ? "bg-success text-white"
                                                                                                     : "bg-light text-muted")"
                                                                                                                             style="width: 45px;
                                                                                                                                            height: 45px;
                                                                                                                                            border: 3px solid
                                                            @(isActive
                                                                                                     ? "green"
                                                                                                     : "lightgray");">

                                    <i class="bi bi-@icon fs-3"></i>

                                        </div>


                                        <!-- Status Name -->
                                        <small class="@(isActive
                                                                                                       ? "text-success fw-bold"
                                                                                                       : "text-muted")">

                                    @displayStatus

                                        </small>


                                        <!-- Current Status -->
                                @if (isCurrent && Model.Status != "Delivered")
                                        {
                                            <br />

                                            <span class="badge bg-primary mt-1">
                                                Current
                                            </span>
                                        }

                                    </div>
                                }

                            </div>
                        }

                    </div>


                    <hr />


                    <!-- ========================= -->
                    <!-- Order Details -->
                    <!-- ========================= -->

                    <div class="row mb-4">

                        <!-- Order Date -->
                        <div class="col-md-6 mb-3">

                            <h6 class="text-muted">
                                Order Date
                            </h6>

                            <p class="mb-0">
                                @Model.OrderDate.ToString("MMM dd, yyyy")
                            </p>

                        </div>


                        <!-- Estimated Delivery -->
                        <div class="col-md-6 mb-3">

                            <h6 class="text-muted">
                                Estimated Delivery
                            </h6>

                            <p class="mb-0">

                                @if (Model.Status == "Delivered")
                                {
                                    <span class="text-success">
                                        Delivered on
                                        @Model.OrderDate.ToString("MMM dd, yyyy")
                                    </span>
                                }
                                else if (Model.Status == "Cancelled")
                                {
                                    <span class="text-danger">
                                        Order Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        30-45 minutes
                                    </span>
                                }

                            </p>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- Delivery Information -->
                    <!-- ========================= -->

                    <div class="row mb-4">

                        <!-- Delivery Address -->
                        <div class="col-md-6 mb-3">

                            <h6 class="text-muted">
                                Delivery Address
                            </h6>

                            <p class="mb-0">
                                @Model.DeliveryAddress
                            </p>

                        </div>


                        <!-- Phone -->
                        <div class="col-md-6 mb-3">

                            <h6 class="text-muted">
                                Contact Number
                            </h6>

                            <p class="mb-0">
                                @Model.Phone
                            </p>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- Order Items -->
                    <!-- ========================= -->

                    <h6 class="mb-3">
                        Order Items
                    </h6>

                    <div class="table-responsive">

                        <table class="table table-sm align-middle">

                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Name</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>

                                        <!-- Image -->
                                        <td>

                                            <img src="@item.FoodItem?.ImageUrl"
                                                 alt="@item.FoodItem?.Name"
                                                 style="width: 50px;
                                                            height: 50px;
                                                            object-fit: cover;"
                                                 class="rounded" />

                                        </td>


                                        <!-- Name -->
                                        <td>
                                            @item.FoodItem?.Name
                                        </td>


                                        <!-- Quantity -->
                                        <td>
                                            @item.Quantity
                                        </td>


                                        <!-- Price -->
                                        <td>
                                            ₹@((item.Quantity * item.FoodItem?.Price)?.ToString("F2"))
                                        </td>

                                    </tr>
                                }

                            </tbody>


                            <!-- Total -->
                            <tfoot>

                                <tr>

                                    <td colspan="3" class="text-end">
                                        <strong>Total Amount:</strong>
                                    </td>

                                    <td>
                                        <strong>
                                            ₹@Model.TotalAmount.ToString("F2")
                                        </strong>
                                    </td>

                                </tr>

                            </tfoot>

                        </table>

                    </div>


                    <!-- ========================= -->
                    <!-- Back Button -->
                    <!-- ========================= -->

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-controller="Order"
                           asp-action="MyOrders"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back to My Orders

                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>